<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - PlayLocal</title>

    <!-- Bootstrap 5 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        body {
            background: #f8fdfa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            min-height: 100vh;
        }

        .navbar {
            background: #16a34a !important;
            padding: 1.2rem 0;
            box-shadow: 0 4px 20px rgba(22, 163, 74, 0.3);
        }

        .logo {
            font-size: 2rem;
            font-weight: 800;
            color: white !important;
        }

        .nav-links a {
            color: white !important;
            font-weight: 600;
            margin: 0 15px;
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s;
        }

            .nav-links a:hover {
                background: rgba(255, 255, 255, 0.2);
                transform: translateY(-2px);
            }

        .nav-links .logout {
            background: rgba(220, 38, 38, 0.3);
        }

            .nav-links .logout:hover {
                background: #dc2626 !important;
            }

        .welcome-header {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            text-align: center;
            margin: 40px auto;
            max-width: 900px;
        }

            .welcome-header h2 {
                font-size: 2.3rem;
                font-weight: 700;
                color: #1f2937;
            }

            .welcome-header p {
                font-size: 1.2rem;
                color: #6b7280;
                margin-top: 10px;
            }

        .dashboard {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
        }

        footer {
            text-align: center;
            padding: 30px;
            background: #111827;
            color: #9ca3af;
            margin-top: 80px;
        }

            footer a {
                color: #16a34a;
                text-decoration: none;
            }

                footer a:hover {
                    color: white;
                }
    </style>
</head>
<body>

    <!-- Navbar - Exactly like yours, but beautiful -->
    <nav class="navbar">
        <div class="container-fluid d-flex justify-content-between align-items-center px-5">
            <div class="logo">PlayLocal</div>
            <ul class="nav-links d-flex list-unstyled mb-0">
                <li><a asp-controller="Player" asp-action="PlayerHome">Home</a></li>
                <li><a href="#">My Bookings</a></li>
                <li><a href="#">Profile</a></li>
                <li>
                    <a asp-controller="Home" asp-action="Logout" class="logout">
                        Logout
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Main Content Area -->
    <section class="dashboard mt-4">
            
        <div>
            @RenderBody()
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2025 PlayLocal • All Rights Reserved</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>