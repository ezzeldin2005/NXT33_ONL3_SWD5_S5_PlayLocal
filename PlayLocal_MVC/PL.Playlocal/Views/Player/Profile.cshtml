@model PL.Playlocal.ViewModels.PlayerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_PlayerLayout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="bg-success text-white py-5 text-center">
                    <h2 class="mb-1">@Model.FullName</h2>
                    <p class="mb-0 opacity-90">
                        <i class="fas fa-futbol"></i> Player
                    </p>
                </div>

                <!-- Body -->
                <div class="card-body p-5">
                    <h4 class="text-success mb-4">
                        <i class="fas fa-user-circle"></i> Profile Information
                    </h4>

                    <div class="row g-4">
                        <div class="col-md-12">
                            <div class="d-flex align-items-center p-4 bg-light rounded-4 border-start border-success border-5">
                                <i class="fas fa-user text-success me-4 fa-2x"></i>
                                <div>
                                    <small class="text-muted d-block">Full Name</small>
                                    <h5 class="mb-0 fw-bold">@Model.FullName</h5>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex align-items-center p-4 bg-light rounded-4 border-start border-success border-5">
                                <i class="fas fa-envelope text-success me-4 fa-2x"></i>
                                <div>
                                    <small class="text-muted d-block">Email Address</small>
                                    <h5 class="mb-0">@Model.Email</h5>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex align-items-center p-4 bg-light rounded-4 border-start border-success border-5">
                                <i class="fas fa-phone text-success me-4 fa-2x"></i>
                                <div>
                                    <small class="text-muted d-block">Phone Number</small>
                                    <h5 class="mb-0">@Model.PhoneNumber</h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5">

                    <div class="text-center">
                        <a asp-action="PlayerHome" class="btn btn-outline-success btn-lg px-5">
                            Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
