@model IEnumerable<CourtViewModel>
@{
    ViewData["Title"] = "Book a Court";
    Layout = "_PlayerLayout"; 
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-success">Hi, @ViewBag.UserName!</h1>
        <p class="lead text-muted">Find and book your perfect court</p>
    </div>

    <div class="row g-4">
        @foreach (var court in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-lg border-0 overflow-hidden hover-lift">

                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title text-success fw-bold mb-2">@court.Name</h5>

                        <h6 class="text-primary mb-2">
                            <i class="fas fa-building"></i>
                            @(ViewBag.VenueInfo[court.CourtID]?.Name ?? "Unknown Venue")
                        </h6>
                        <p class="text-muted small mb-3">
                            <i class="fas fa-location-dot"></i>
                            @(ViewBag.VenueInfo[court.CourtID]?.Address ?? "No address")
                        </p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-success fs-6">@court.Size-a-side</span>
                            <span class="badge bg-info fs-6">@court.Surface</span>
                            <span class="badge bg-warning text-dark fs-6">@court.Environment</span>
                        </div>

                        <div class="mb-3">
                            <strong class="text-muted">Sports:</strong>
                            @if (court.AvailableSports.Any())
                            {
                                foreach (var sport in court.AvailableSports)
                                {
                                    <span class="badge rounded-pill bg-primary me-1">@sport.Name</span>
                                }
                            }
                        </div>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="text-success fw-bold">@court.PricePerHour EGP/hr</h4>
                            </div>
                            <a asp-controller="Player" asp-action="BookCourt" asp-route-courtId="@court.CourtID"
                               class="btn btn-success btn-lg w-100">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
