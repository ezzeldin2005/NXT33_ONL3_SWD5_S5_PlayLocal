@{
    ViewData["Title"] = "Player Dashboard";
    Layout = "_PlayerLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Player Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>
<body>

    <div class="welcome-header">
        <h2>
            Welcome back, <span class="text-success">@ViewBag.UserName!</span>
        </h2>
        <p>Browse and book your favorite football fields</p>
    </div>

        <div id="venuesGrid" class="venues-grid">
            <!-- Venues will be loaded here  -->
        </div>
    </section>

    <!-- Venue Details Modal -->
    <div id="venueModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeVenueModal()">×</span>
            <h2 id="modalVenueName" class="mb-4"></h2>
            <div id="modalBody"></div>
        </div>
    </div>

</body>
</html>