@model SignUpViewModel
@{
    ViewData["Title"] = "Sign Up";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/style.css" />
</head>
<body>
    <div class="auth-container">
        <h2>Create a New Account</h2>

        <form asp-action="SignUp" asp-controller="Home" method="post">
            @*@Html.AntiForgeryToken()*@ 

            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="example@mail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="01012345678" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="********" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" name="ConfirmPassword" class="form-control" placeholder="********" required />
                @if (ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0)
                {
                    <span class="text-danger">@ViewData.ModelState["ConfirmPassword"].Errors[0].ErrorMessage</span>
                }
            </div>

            <div class="form-group">
                <label asp-for="AccountType"></label>
                <select asp-for="AccountType" class="form-control" asp-items="Html.GetEnumSelectList<AccountType>()">
                    <option value="" disabled selected>Select account type</option>
                </select>
                <span asp-validation-for="AccountType" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Sign Up</button>
        </form>

        <p>Already have an account? <a asp-action="Login" class="text-success fw-bold text-decoration-none">Log In</a></p>
    </div>

</body>
</html>