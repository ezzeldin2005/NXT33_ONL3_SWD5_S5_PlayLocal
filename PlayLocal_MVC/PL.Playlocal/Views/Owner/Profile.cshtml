@model PL.Playlocal.ViewModels.OwnerViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_OwnerLayout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <!-- Header -->
                <div class="bg-success text-white py-5 text-center">
                    <div class="avatar-circle mx-auto mb-3 bg-white text-success d-flex align-items-center justify-content-center">
                        <i class="fas fa-user-tie fa-4x"></i>
                    </div>
                    <h2 class="mb-1">@Model.FullName</h2>
                    <p class="mb-0 opacity-90">
                        <i class="fas fa-crown"></i> Venue Owner
                    </p>
                </div>

                <!-- Body -->
                <div class="card-body p-5">
                    <h4 class="text-success mb-4">
                        <i class="fas fa-id-card"></i> Profile Information
                    </h4>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="info-item d-flex align-items-center p-3 bg-light rounded-3">
                                <i class="fas fa-user text-success me-3 fa-lg"></i>
                                <div>
                                    <small class="text-muted">Full Name</small>
                                    <p class="mb-0 fw-bold">@Model.FullName</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-item d-flex align-items-center p-3 bg-light rounded-3">
                                <i class="fas fa-envelope text-success me-3 fa-lg"></i>
                                <div>
                                    <small class="text-muted">Email Address</small>
                                    <p class="mb-0 fw-bold">@Model.Email</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-item d-flex align-items-center p-3 bg-light rounded-3">
                                <i class="fas fa-phone text-success me-3 fa-lg"></i>
                                <div>
                                    <small class="text-muted">Phone Number</small>
                                    <p class="mb-0 fw-bold">@Model.PhoneNumber</p>
                                </div>
                            </div>
                        </div>

                    </div>

                    <hr class="my-5">

                    <div class="text-center">
                        <a asp-action="OwnerHome" class="btn btn-outline-success btn-lg px-5">
                            Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
