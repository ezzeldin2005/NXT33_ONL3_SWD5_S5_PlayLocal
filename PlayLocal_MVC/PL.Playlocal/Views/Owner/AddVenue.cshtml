@model VenueViewModel
@{
    ViewData["Title"] = "Add New Venue";
    Layout = "_OwnerLayout";
    var ownerId = Context.Session.GetString("UserId");
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="fas fa-futbol"></i> Add New Venue
                    </h3>
                </div>
                <div class="card-body p-5">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <strong>Please fix the following errors:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-controller="Owner" asp-action="AddVenue" method="post">
                        @*@Html.AntiForgeryToken()*@

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Green Valley Stadium" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Full address: Street, Area, City" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Tell players about your field... (optional)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GoogleMapsLink" class="form-label"></label>
                            <input asp-for="GoogleMapsLink" class="form-control" placeholder="https://maps.google.com/..." />
                            <span asp-validation-for="GoogleMapsLink" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MainContactPhone" class="form-label fw-bold"></label>
                            <input asp-for="MainContactPhone" class="form-control" placeholder="01012345678" />
                            <span asp-validation-for="MainContactPhone" class="text-danger"></span>
                        </div>

                        <div class="mt-5">
                            <h4 class="fw-bold text-success mb-4">
                                Working Hours
                            </h4>
                            <div class="row g-3">
                                @for (int i = 0; i < Model.WorkingHours.Count; i++)
                                {
                                    var day = Model.WorkingHours[i];
                                    var dayName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day.DayOfWeek);

                                    <div class="col-md-6 col-lg-4">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <h6 class="fw-bold mb-0">@dayName</h6>
                                                </div>

                                                <div class="row g-2">
                                                    <div class="col-6">
                                                        <label class="small text-muted">Open</label>
                                                        <input type="time" class="form-control form-control-sm"
                                                               asp-for="@Model.WorkingHours[i].OpenTime"
                                                               required="@day.IsOpen" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="small text-muted">Close</label>
                                                        <input type="time" class="form-control form-control-sm"
                                                               asp-for="@Model.WorkingHours[i].CloseTime"
                                                               required="@day.IsOpen" />
                                                    </div>
                                                </div>

                                                <input type="hidden" asp-for="@Model.WorkingHours[i].DayOfWeek" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="HasEquipmentRental" class="form-check-input" type="checkbox" />
                                <label asp-for="HasEquipmentRental" class="form-check-label">
                                    This venue offers equipment rental (balls, bibs, etc.)
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="OwnerHome" asp-controller="Owner" class="btn btn-secondary me-md-3">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="fas fa-save"></i> Add Venue
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

}